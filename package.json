{
  "name": "gd-clipboard",
  "productName": "GD Clipboard",
  "version": "1.0.0",
  "description": "Clipboard history manager: keeps your last 10-15 copies, sorted by type, ready to paste.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.graphicsdaniel.gdclipboard",
    "productName": "GD Clipboard",
    "files": ["main.js", "preload.js", "src/**", "renderer/**", "assets/**"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "mac": { "target": "dmg", "icon": "assets/icon.png", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" }
  }
}
